# Example nginx server block for the Max Masarski portfolio site.
#
# This is a STARTING POINT, not a drop-in config: it assumes a build already
# copied to /var/www/portfolio/dist (see DEPLOY.md) and a domain that is not
# yet registered. Replace every "example.com" below with the real domain.
#
# HTTPS is deliberately left out of this block. Once the domain's A record
# points at this server, run certbot against it (e.g.
# `certbot --nginx -d example.com -d www.example.com`) — certbot rewrites
# this file in place to add the `listen 443 ssl` server block and the
# certificate paths, and adds an HTTP -> HTTPS redirect. Do that AFTER this
# base config is verified working over plain HTTP, not before.

server {
    listen 80;
    server_name example.com www.example.com;   # replace with the real domain
    root /var/www/portfolio/dist;
    index index.html;

    # SPA fallback — required, or a hard refresh / direct link to
    # /projects/pray-for-plagues 404s. React Router only sees this route
    # client-side; nginx has no file at that path, so without try_files
    # falling back to /index.html, nginx returns a bare 404 instead of
    # letting the app boot and route itself.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed assets: cache hard. Vite fingerprints every JS chunk by content
    # hash, so a new deploy always ships new filenames — a 1-year cache here
    # can never serve stale code. `^~` makes this a "preferential" prefix
    # match, so it wins over the regex location below for anything under
    # /assets/ regardless of extension (plain prefix locations lose to regex
    # locations in nginx's matching order; `^~` is what restores intent here
    # — today dist/assets/ is JS-only, but this keeps it correct if a hashed
    # .svg or .webp ever lands there too). A single Cache-Control header
    # (not also `expires`, which would silently add a second one) keeps the
    # response to one unambiguous cache directive.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Media and fonts: these are STABLE, UNHASHED filenames (not
    # content-addressed) — replacing /media/hero-background.webp in place
    # means some visitors keep serving the old bytes for up to 30 days. That
    # is a deliberate trade for a mostly-static portfolio, not an oversight;
    # if you replace a file in place and need it to update immediately,
    # rename it (and update the reference) instead of relying on a shorter
    # cache window.
    location ~* \.(woff2|mp4|webm|webp|jpg|png|svg)$ {
        add_header Cache-Control "public, max-age=2592000";
    }

    # index.html must never be cached, or deploys appear not to land
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    gzip on;
    # This build emits zero CSS (Emotion injects styles at runtime) — JS is
    # the entire compressible payload. `text/javascript` is included because
    # recent nginx `mime.types` maps `.js` to `text/javascript`, not
    # `application/javascript`; omitting it means every bundle ships
    # uncompressed on such a server (roughly 3x the transfer size).
    gzip_types text/css text/javascript application/javascript image/svg+xml application/json;
    gzip_min_length 1024;
}
